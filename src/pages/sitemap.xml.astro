---
import { getCollection } from 'astro:content';

export const prerender = false;

const siteUrl = 'https://osbord.com';

const posts = await getCollection('blog');

const staticPages = [
  { url: '/', priority: '1.0', changefreq: 'weekly' },
  { url: '/blog/', priority: '0.9', changefreq: 'daily' },
  { url: '/masters/wedding-planner', priority: '0.9', changefreq: 'monthly' },
  { url: '/masters/interiorismo', priority: '0.9', changefreq: 'monthly' },
  { url: '/masters/paisajismo', priority: '0.8', changefreq: 'monthly' },
  { url: '/masters/enfermeria', priority: '0.8', changefreq: 'monthly' },
  { url: '/legal', priority: '0.2', changefreq: 'yearly' },
  { url: '/privacidad', priority: '0.2', changefreq: 'yearly' },
  { url: '/cookies', priority: '0.2', changefreq: 'yearly' },
];

const xml = `<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
${staticPages.map(page => `  <url>
    <loc>${siteUrl}${page.url}</loc>
    <changefreq>${page.changefreq}</changefreq>
    <priority>${page.priority}</priority>
  </url>`).join('\n')}
${posts.map(post => {
  const postUrl = `${siteUrl}/blog/${post.data.category}/${post.id}`;
  const lastmod = post.data.publishDate.toISOString().split('T')[0];
  return `  <url>
    <loc>${postUrl}</loc>
    <lastmod>${lastmod}</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.7</priority>
  </url>`;
}).join('\n')}
</urlset>`;

return new Response(xml, {
  headers: { 'Content-Type': 'application/xml; charset=utf-8' }
});
---
