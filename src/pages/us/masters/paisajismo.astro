---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import CourseAccordion from '../../../components/CourseAccordion.astro';
import Testimonials from '../../../components/Testimonials.astro';
import FAQ from '../../../components/FAQ.astro';
import CTASection from '../../../components/CTASection.astro';
import TeachersSection from '../../../components/TeachersSection.astro';
import AccreditationBadge from '../../../components/AccreditationBadge.astro';
import { Image } from 'astro:assets';
import paisajeImg from '../../../assets/school_paisajismo.png';
import WhatsAppBox from '../../../components/WhatsAppBox.astro';
import BenefitsSection from '../../../components/BenefitsSection.astro';
import DiplomaSection from '../../../components/DiplomaSection.astro';

const isUS = true;
const programName = "Diseño de Exteriores y Paisajismo 3D";
const formationFullName = "Máster en Diseño de Exteriores, Paisajismo y Render 3D";

const benefits = [
  {
    title: "Proyectos Reales",
    description: "Desarrolla un portafolio con proyectos completos de diseño exterior: planimetría técnica, render fotorrealista y presupuesto profesional.",
    icon: '<svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.409a2.25 2.25 0 013.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 001.5-1.5V6a1.5 1.5 0 00-1.5-1.5H3.75A1.5 1.5 0 002.25 6v12a1.5 1.5 0 001.5 1.5zm10.5-11.25h.008v.008h-.008V8.25zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z"/></svg>',
    tag: "Portafolio Elite"
  },
  {
    title: "Dominio Técnico Total",
    description: "Maneja el stack completo del profesional moderno: AutoCAD, Vectorworks Landmark, SketchUp y Lumion para renders de alto impacto.",
    icon: '<svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 7.5l-9-5.25L3 7.5m18 0l-9 5.25m9-5.25v9l-9 5.25M3 7.5l9 5.25M3 7.5v9l9 5.25m0-9v9"/></svg>',
    tag: "Tech-Elite"
  },
  {
    title: "Mercado en Expansión",
    description: "El diseño de exteriores y paisajismo de lujo es uno de los nichos más rentables y con mayor demanda en LATAM, España y EE.UU.",
    icon: '<svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"/></svg>',
    tag: "Alta Demanda"
  },
  {
    title: "IA Aplicada",
    description: "Integra herramientas de inteligencia artificial para generación de conceptos, selección vegetal y presentación comercial a clientes.",
    icon: '<svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09z"/></svg>',
    tag: "IA + Diseño"
  },
  {
    title: "Red de Contactos",
    description: "Conéctate con arquitectos paisajistas, desarrolladores de Real Estate y marcas de outdoor a través de nuestra red internacional.",
    icon: '<svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/></svg>',
    tag: "Networking"
  },
  {
    title: "Certificado Internacional",
    description: "Obtén un certificado con validez internacional respaldado por la autoridad institucional del Instituto Osbord en Estados Unidos.",
    icon: '<svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12.75 11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 0 1-1.043 3.296 3.745 3.745 0 0 1-3.296 1.043A3.745 3.745 0 0 1 12 21c-1.268 0-2.39-.63-3.068-1.593a3.746 3.746 0 0 1-3.296-1.043 3.745 3.745 0 0 1-1.043-3.296A3.745 3.745 0 0 1 3 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 0 1 1.043-3.296 3.746 3.746 0 0 1 3.296-1.043A3.746 3.746 0 0 1 12 3c1.268 0 2.39.63 3.068 1.593a3.746 3.746 0 0 1 3.296 1.043 3.746 3.746 0 0 1 1.043 3.296A3.745 3.745 0 0 1 21 12Z"/></svg>',
    tag: "Legalización"
  }
];

const syllabus = [
  {
    title: "MÓDULO 1: FUNDAMENTOS Y BOTÁNICA APLICADA AL DISEÑO",
    content: [
      "Historia y principios del paisajismo; diferencias con el interiorismo.",
      "Análisis de terreno: topografía, orientación solar, clima y suelo.",
      "Clasificación de especies vegetales por función, porte y clima.",
      "Selección de plantas según zona climática (LATAM, España y EE.UU.).",
      "Paletas vegetales, xerojardinería y mantenimiento de especies.",
      "Examen Módulo 1."
    ]
  },
  {
    title: "MÓDULO 2: COMPOSICIÓN Y DISTRIBUCIÓN DE ESPACIOS EXTERIORES",
    content: [
      "Zonificación funcional: social, privada y de servicio.",
      "Circulación, senderos y puntos focales.",
      "Estilos de jardín: mediterráneo, tropical, zen y contemporáneo.",
      "Casos de estudio de proyectos residenciales y comerciales.",
      "Examen Módulo 2."
    ]
  },
  {
    title: "MÓDULO 3: HARDSCAPING Y OUTDOOR LIVING",
    content: [
      "Terrazas, patios, pérgolas, piscinas y muros de contención.",
      "Materiales: piedra natural, madera, concreto y deck.",
      "Iluminación exterior técnica y decorativa.",
      "Cocinas exteriores, áreas de fogata y mobiliario de exterior.",
      "Tendencias: diseño biofílico, jardines comestibles, low-maintenance.",
      "Examen Módulo 3."
    ]
  },
  {
    title: "MÓDULO 4: PLANIMETRÍA TÉCNICA — AUTOCAD Y VECTORWORKS LANDMARK",
    content: [
      "Interfaz y Configuración Pro en AutoCAD.",
      "Demostración Técnica: AutoCAD (Parte I).",
      "Demostración Técnica: AutoCAD (Parte II).",
      "Demostración Técnica: AutoCAD (Parte III).",
      "Dibujo Técnico: Muros, Vanos y Estructuras.",
      "Gestión de Capas (Layers) y Bloques Dinámicos.",
      "Maquetación, Escalas e Impresión Profesional.",
      "Planos de plantación con medidas y especificaciones técnicas.",
      "De AutoCAD a SketchUp: Topografía.",
      "Diseño de sistemas de riego y manejo de drenaje.",
      "Introducción a Vectorworks Landmark y librerías botánicas.",
      "Demostración Técnica: Vectorworks Landmark (Parte I).",
      "Demostración Técnica: Vectorworks Landmark (Parte II).",
      "Examen Módulo 4."
    ]
  },
  {
    title: "MÓDULO 5: MODELADO 3D Y RENDER — SKETCHUP Y LUMION",
    content: [
      "Demostración Técnica: SketchUp (Parte I).",
      "Demostración Técnica: SketchUp (Parte II).",
      "Fundamentos de modelado 3D en SketchUp para paisajismo.",
      "Plugins de vegetación y mobiliario exterior.",
      "Modelado Ágil y Arquitectónico en SketchUp Pro.",
      "Organización Avanzada: Grupos, Componentes y Etiquetas.",
      "Modelado de terreno y curvas de nivel.",
      "Demostración Técnica: Lumion (Parte I).",
      "Demostración Técnica: Lumion (Parte II).",
      "Demostración Técnica: Lumion (Parte III).",
      "Demostración Técnica: Lumion (Parte IV).",
      "Render fotorrealista en Lumion: iluminación, atmósferas y materiales.",
      "Examen Módulo 5."
    ]
  },
  {
    title: "MÓDULO 6: GESTIÓN DE PROYECTOS, PRESUPUESTOS Y EMPRENDIMIENTO",
    content: [
      "Costeo de materiales y mano de obra; gestión de proveedores.",
      "Contratos, cronogramas y aspectos legales.",
      "Pricing de servicios y presentación de propuestas a clientes.",
      "Marketing digital para paisajistas y diseñadores de exteriores.",
      "Examen Módulo 6."
    ]
  },
  {
    title: "MÓDULO 7: DISEÑO DE EXTERIORES Y PAISAJISMO CON IA",
    content: [
      "Generación de conceptos e ideación con IA (Midjourney, DALL-E u otras) para propuestas preliminares antes del modelado.",
      "IA aplicada a selección vegetal y diagnóstico: identificación de especies, plagas y sugerencias de paletas por clima.",
      "IA para presentación y comunicación con cliente: mejora de renders, variaciones de propuesta y redacción asistida de propuestas comerciales.",
      "Examen Módulo 7."
    ]
  },
  {
    title: "MÓDULO 8: PROYECTO FINAL INTEGRADOR",
    content: [
      "Diseño completo de un proyecto real o simulado.",
      "Entregables: planimetría técnica, render 3D, presupuesto y presentación."
    ]
  }
];

const courseSchema = {
  "@context": "https://schema.org",
  "@type": "Course",
  "name": "Máster en Diseño de Exteriores, Paisajismo y Render 3D",
  "description": "Formación técnica de alto nivel en diseño de exteriores, paisajismo y visualización 3D con AutoCAD, Vectorworks Landmark, SketchUp y Lumion. 8 módulos especializados con diploma apostillado.",
  "provider": {
    "@type": "EducationalOrganization",
    "name": "Instituto Online Osbord",
    "url": "https://osbord.edu"
  },
  "educationalLevel": "Máster",
  "numberOfCredits": 60,
  "hasCourseInstance": {
    "@type": "CourseInstance",
    "courseMode": "Online",
    "courseWorkload": "PT600H"
  }
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Inicio", "item": "https://osbord.edu" },
    { "@type": "ListItem", "position": 2, "name": "Escuela de Arquitectura y Diseño", "item": "https://osbord.edu/us/escuela/design" },
    { "@type": "ListItem", "position": 3, "name": "Máster en Diseño de Exteriores, Paisajismo y Render 3D", "item": "https://osbord.edu/us/masters/paisajismo" }
  ]
};
---

<Layout
  title="Máster en Diseño de Exteriores, Paisajismo y Render 3D"
  description="Domina el paisajismo y el diseño de exteriores de lujo. Aprende AutoCAD, Vectorworks Landmark, SketchUp y Lumion. Certificación internacional con diploma apostillado."
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(courseSchema)} />
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <Header />
  <main>
    <!-- Course Hero -->
    <section class="bg-brand-navy py-24 lg:py-32 text-white relative overflow-hidden">
      <div class="absolute inset-0 opacity-40">
        <Image src={paisajeImg} alt="Diseño de Exteriores y Paisajismo 3D" class="w-full h-full object-cover" width={1920} height={1080} loading="eager" />
      </div>
      <div class="absolute inset-0 bg-gradient-to-r from-brand-navy via-brand-navy/60 to-transparent"></div>

      <div class="relative max-w-7xl mx-auto px-6">
        <nav class="mb-12" aria-label="Breadcrumb">
          <ol class="flex items-center gap-2 text-xs text-gray-400">
            <li><a href="/us/" class="hover:text-brand-gold transition-colors">Inicio</a></li>
            <li><span class="mx-1">/</span></li>
            <li><a href="/us/escuela/design" class="hover:text-brand-gold transition-colors">Arquitectura y Diseño</a></li>
            <li><span class="mx-1">/</span></li>
            <li class="text-brand-gold font-semibold text-[10px] tracking-widest">Paisajismo 3D</li>
          </ol>
        </nav>

        <div class="grid lg:grid-cols-2 gap-16 items-center">
          <div class="space-y-8 animate-fade-in-up">
            <span class="section-label">Escuela de Arquitectura y Diseño</span>
            <h1 class="text-4xl sm:text-5xl lg:text-7xl font-extrabold text-white leading-[1.05] tracking-tight uppercase">
              MÁSTER EN <span class="text-brand-gold">PAISAJISMO 3D</span>
            </h1>
            <div class="flex items-center gap-4">
              <div class="w-12 h-1 bg-brand-gold"></div>
              <p class="text-xl text-white font-bold tracking-widest uppercase">
                Diseño de Exteriores y Render 3D
              </p>
            </div>
            <p class="text-lg text-gray-200 max-w-lg leading-relaxed">
              Transforma espacios exteriores con maestría técnica. Especialización avanzada en paisajismo de lujo, outdoor living y visualización fotorrealista con Lumion y SketchUp.
            </p>

            <!-- Stats Row -->
            <div class="flex flex-wrap items-center gap-8 pt-4">
              <div class="flex flex-col">
                <p class="text-brand-gold font-extrabold text-3xl">8</p>
                <p class="text-[10px] uppercase tracking-[0.2em] text-gray-400 font-bold">Módulos</p>
              </div>
              <div class="w-px h-10 bg-white/20"></div>
              <div class="flex flex-col">
                <p class="text-brand-gold font-extrabold text-3xl">3 Meses</p>
                <p class="text-[10px] uppercase tracking-[0.2em] text-gray-400 font-bold">Duración</p>
              </div>
              <div class="w-px h-10 bg-white/20"></div>
              <div class="flex flex-col">
                <p class="text-brand-gold font-extrabold text-3xl">Online</p>
                <p class="text-[10px] uppercase tracking-[0.2em] text-gray-400 font-bold">Modalidad</p>
              </div>
            </div>
          </div>

          <!-- Form Side (US) or WhatsApp (Latam) -->
          <div class="relative animate-fade-in-up delay-300">
            <div class="absolute -top-10 -right-6 z-20">
              <AccreditationBadge className="scale-75 md:scale-90" />
            </div>
            <WhatsAppBox programName={programName} />
          </div>
        </div>
      </div>
    </section>


    <!-- Syllabus Section -->
    <section class="section-padding bg-white">
      <div class="grid lg:grid-cols-3 gap-16">
        <div class="lg:col-span-1 space-y-6">
          <p class="section-label">Plan de Estudios</p>
          <h2 class="text-3xl font-extrabold tracking-tight">Programa Académico</h2>
          <div class="gold-divider"></div>
          <p class="text-gray-500 leading-relaxed">
            Formación integral que combina botánica aplicada, diseño de espacios exteriores y el dominio técnico de las herramientas 3D más demandadas del sector.
          </p>

          <div class="p-6 bg-brand-neutral rounded-brand-lg border border-gray-100 space-y-4">
            <h4 class="font-extrabold text-sm uppercase tracking-wider">¿Qué incluye?</h4>
            <ul class="space-y-3">
              <li class="flex items-center gap-3 text-sm text-gray-600">
                <span class="w-5 h-5 rounded-full bg-brand-gold/10 flex items-center justify-center flex-shrink-0">
                  <span class="w-1.5 h-1.5 bg-brand-gold rounded-full"></span>
                </span>
                Acceso al campus virtual.
              </li>
              <li class="flex items-center gap-3 text-sm text-gray-600">
                <span class="w-5 h-5 rounded-full bg-brand-gold/10 flex items-center justify-center flex-shrink-0">
                  <span class="w-1.5 h-1.5 bg-brand-gold rounded-full"></span>
                </span>
                Biblioteca de assets y librerías botánicas.
              </li>
              <li class="flex items-center gap-3 text-sm text-gray-600">
                <span class="w-5 h-5 rounded-full bg-brand-gold/10 flex items-center justify-center flex-shrink-0">
                  <span class="w-1.5 h-1.5 bg-brand-gold rounded-full"></span>
                </span>
                Certificado al finalizar.
              </li>
              <li class="flex items-center gap-3 text-sm text-gray-600">
                <span class="w-5 h-5 rounded-full bg-brand-gold/10 flex items-center justify-center flex-shrink-0">
                  <span class="w-1.5 h-1.5 bg-brand-gold rounded-full"></span>
                </span>
                Comunidad privada de alumnos.
              </li>
            </ul>
          </div>
        </div>

        <div class="lg:col-span-2">
          <CourseAccordion syllabus={syllabus} />
        </div>
      </div>
    </section>

    <BenefitsSection formationName={programName} benefits={benefits} />

    <TeachersSection limitTo={["Prof. Alejandro Vivas"]} />
    <DiplomaSection />
    <Testimonials />

    <CTASection
      variant="dark"
      headline="Diseña exteriores que inspiran, crea renders que conquistan"
      subtext="Únete a la próxima cohorte del Máster en Paisajismo 3D y conviértete en un profesional del diseño de exteriores con certificación internacional."
      buttonText="SOLICITAR ADMISIÓN"
      programName={formationFullName}
    />
  </main>
  <Footer />
</Layout>
